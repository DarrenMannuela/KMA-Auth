# Copy this file to .env and fill in real values. .env is gitignored —
# never commit it.

# development or production. Forces gin.ReleaseMode, requires Secure
# cookies (HTTPS), and changes nothing else about validation strictness.
AUTH_ENV=development

AUTH_PORT=8001

# Where the sqlite file lives. Inside Docker this is /app/db_data/auth.sqlite
# (see docker-compose.yaml's volume mount); outside Docker it's relative
# to wherever you run the binary from.
AUTH_DB_PATH=./db_data/auth.sqlite

# Leave empty for localhost development. Set to your real domain in
# production (e.g. ".example.com") so the cookie is scoped correctly
# behind nginx/a reverse proxy.
AUTH_COOKIE_DOMAIN=

# Comma-separated list of origins allowed to call this API with
# credentials. Must match the frontend's origin(s) exactly — no
# wildcards (see README-AUTH.md's CORS section for why).
AUTH_ALLOWED_ORIGINS=http://localhost:5173

# Sliding idle timeout and hard absolute ceiling for a session. Idle
# resets on every authenticated request; absolute does not. See
# config.go for how the two interact.
AUTH_SESSION_IDLE_TTL_HOURS=12
AUTH_SESSION_ABSOLUTE_TTL_HOURS=6

# Per-account brute-force lockout.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# Shared secret the main KMA backend must send as X-Internal-Key when
# calling POST /internal/validate. Generate with:
#   openssl rand -hex 32
# Must be identical on both services — see AuthRotate.md to rotate it.
AUTH_INTERNAL_KEY=

# First admin account, auto-created only if the users table is empty
# (fresh database). Log in and change this password immediately.
AUTH_BOOTSTRAP_EMAIL=
AUTH_BOOTSTRAP_PASSWORD=

# Gmail SMTP, used to send "set your password" invite links from
# CreateUser. AUTH_SMTP_APP_PASSWORD is a Gmail App Password (requires
# 2-Step Verification on the sending account) — not the account's
# normal login password.
AUTH_SMTP_HOST=smtp.gmail.com
AUTH_SMTP_PORT=587
AUTH_SMTP_USERNAME=
AUTH_SMTP_APP_PASSWORD=
# Defaults to AUTH_SMTP_USERNAME if left blank.
AUTH_SMTP_FROM=

# The frontend's own origin, used to build the absolute
# "…/set-password?token=…" link inside invite emails.
AUTH_APP_BASE_URL=http://localhost:5173

# How long an invite link stays valid before an admin has to issue a
# fresh one.
AUTH_INVITE_TOKEN_TTL_HOURS=48
