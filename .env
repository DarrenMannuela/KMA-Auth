# ── Server ──────────────────────────────────────────────────────────
AUTH_PORT=8001
# "production" enables Secure cookies (requires HTTPS in front, e.g. a
# reverse proxy). Keep this as "development" for plain-http local work.
AUTH_ENV=development

# ── Database ────────────────────────────────────────────────────────
# Deliberately a *separate* sqlite file from the main KMA app — this
# service owns nothing but identity/session data.
AUTH_DB_PATH=./db_data/auth.sqlite

# ── Cookies / sessions ──────────────────────────────────────────────
# Comma-separated list of origins allowed to call this API with
# credentials (your frontend's dev + prod URLs).
AUTH_ALLOWED_ORIGINS=https://kma.corvus-grouper.ts.net
# Domain the session + CSRF cookies are scoped to. Leave blank for
# "current host" (fine for local dev / same-host deployments). Set to
# e.g. ".kma-app.com" if the frontend and this API sit on different
# subdomains of the same parent domain.
AUTH_COOKIE_DOMAIN=kma.corvus-grouper.ts.net
# How long a session lasts without activity before it's dead, and the
# hard ceiling regardless of activity.
AUTH_SESSION_IDLE_TTL_HOURS=12
AUTH_SESSION_ABSOLUTE_TTL_HOURS=168

# ── Brute-force protection ─────────────────────────────────────────
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ── Service-to-service auth ─────────────────────────────────────────
# The main KMA backend calls POST /internal/validate to check a
# session cookie on the caller's behalf. Only requests presenting this
# shared secret in X-Internal-Key are answered. Generate with:
#   openssl rand -hex 32
AUTH_INTERNAL_KEY=521c4cc1dc70196832b65196f0f0ff39088321a91ca943ba5a68415aab5181e4

# ── Bootstrap admin ─────────────────────────────────────────────────
# On first boot, if the users table is empty, an admin user is created
# from these two values so you're never locked out of an empty DB.
# Remove/rotate the password immediately after first login.
AUTH_BOOTSTRAP_EMAIL=darren.mannuela@gmail.com
AUTH_BOOTSTRAP_PASSWORD=kmA2609!
